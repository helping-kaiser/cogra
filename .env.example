# PostgreSQL
POSTGRES_USER=gnp
POSTGRES_PASSWORD=gnp_secret
POSTGRES_DB=gnp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://gnp:gnp_secret@localhost:5432/gnp_db

# API
API_HOST=0.0.0.0
API_PORT=8080

# Mirror ingestion poll interval (seconds) — how often the server pulls
# newly published epochs through the L1 boundary.
L1_INGEST_INTERVAL_SECS=2

# Epochs before an unlanded staged write is collected
# (data-model.md "Staged writes").
STAGED_WRITE_GC_EPOCHS=8

# Genesis bootstrap (`make bootstrap`) — the Genesis Moderator's identity.
# Supplied at run time (network.md §2); a fork sets its own.
GENESIS_HANDLE=genesis
GENESIS_DISPLAY_NAME=Genesis Moderator

# Logging: trace | debug | info | warn | error
RUST_LOG=debug
