# Compose runtime for the make targets (make-only; the binaries never
# read it). Unset: `docker compose`. Point it at any compose-compatible
# runtime, e.g. podman in a WSL toolbox:
# DOCKER_COMPOSE=wsl.exe -d claude-podman --cd /mnt/c/Users/<name>/dev/cogra -- podman compose -f docker/docker-compose.yml

# PostgreSQL
POSTGRES_USER=gnp
POSTGRES_PASSWORD=gnp_secret
POSTGRES_DB=gnp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://gnp:gnp_secret@localhost:5432/gnp_db

# Media object store — the standalone media service (architecture.md
# "Infrastructure"). Its own container, its own volume, its own lifecycle;
# the API speaks S3 to it and never holds bytes itself.
#
# The endpoint stays on the loopback: only the API and the web server talk
# to the store, both processes on the dev machine, and a phone reaches
# media through the web origin's /media proxy rather than the store — so
# the bucket never needs to be on the network the guests are on.
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=cogra-media
MEDIA_ACCESS_KEY_ID=cogra_media
MEDIA_SECRET_ACCESS_KEY=cogra_media_secret
MEDIA_REGION=us-east-1
MEDIA_PORT=9000
MEDIA_CONSOLE_PORT=9001

# The public origin every MediaAttachment.url is minted against — the media
# service's own origin, never the API's. In development it is the web dev
# server's /media proxy (web/next.config.ts) so a phone reaches the bytes
# over the same https origin as the app; in production it is the media
# origin or the CDN in front of it, and no proxy exists.
MEDIA_BASE_URL=http://localhost:3000/media

# Per-asset upload cap in bytes, enforced at the multipart transport
# before a byte reaches a resolver. 10 MiB: a phone photo is 2–5 MiB.
MEDIA_MAX_UPLOAD_BYTES=10485760

# The orphan sweeper (api-spec.md "Content authoring" — assets are
# uploaded before the write that references them): assets no parent
# references and no profile points at are collected after this age, on
# this interval.
MEDIA_ORPHAN_REAPER_INTERVAL_SECS=600
MEDIA_ORPHAN_MAX_AGE_SECS=86400

# API
API_HOST=0.0.0.0
API_PORT=8080

# Mirror ingestion poll interval (seconds) — how often the server pulls
# newly published epochs through the L1 boundary.
L1_INGEST_INTERVAL_SECS=2

# Epochs before an unlanded staged write is collected
# (data-model.md "Staged writes").
STAGED_WRITE_GC_EPOCHS=8

# Dev epoch clock (seconds) — the API host closes an epoch on this
# interval so writes land without a manual `l1-dev close`. Unset: epochs
# close only on the act budget or the CLI.
L1_EPOCH_CLOSE_INTERVAL_SECS=3

# Dev mailer log file — every outbound message (verification tokens,
# reset links) is also appended here, so hand tests read secrets from one
# file instead of grepping the process log. Unset: no file logging.
DEV_MAILER_LOG=tmp_dev/mailer.log

# The per-environment web origin every emailed link rides on
# (auth.md "Link URLs"): /join/<link-id>, /verify?token=, /reset?token=.
# Default: the local web dev server.
WEB_ORIGIN=http://localhost:3000

# 32-byte hex seed of the Ed25519 session-signing key (auth.md).
# Unset: an ephemeral dev key is generated and sessions die with the
# process. Generate one with: openssl rand -hex 32
# SESSION_SIGNING_SEED=

# The community-funded admission burn per approved applicant
# (micro-units) and the account-reaper sweep interval (auth.md "Reaper":
# never-verified accounts past their bound are deleted whole).
ADMISSION_BURN_MICRO=100000000
ACCOUNT_REAPER_INTERVAL_SECS=600

# Auth-endpoint rate limits (auth.md "Rate limiting") — counts per
# window; the windows and the login backoff's shape are code, not env
# (development.md lists each knob's window). Unset: these defaults.
#RATE_LIMIT_LOGIN_PER_IP=30
#RATE_LIMIT_REGISTER_PER_IP=5
#RATE_LIMIT_REGISTER_PER_LINK=20
#RATE_LIMIT_RESET_PER_IP=10
#RATE_LIMIT_RESET_PER_EMAIL=3
#RATE_LIMIT_RESEND_PER_EMAIL=5
#RATE_LIMIT_CONFIRM_PER_IP=30
#RATE_LIMIT_GC_INTERVAL_SECS=3600

# Media uploads per account per hour. Uploads are not acts, so θ prices
# nothing about them and an insolvent actor can still fill the store —
# this limit is the only cost control there is.
#RATE_LIMIT_UPLOAD_PER_ACCOUNT=60

# Password breach corpus (auth.md "Password requirements"): hibp = the
# live HIBP range API (k-anonymity, fail-open); off = no lookup, for
# offline dev only.
BREACH_CHECK=hibp

# Client-IP derivation for the per-IP limits (auth.md "Rate limiting"):
# ConnectInfo = the socket peer (default). Set RightmostXForwardedFor
# ONLY behind a reverse proxy that is the sole network path to the API.
CLIENT_IP_SOURCE=ConnectInfo

# Genesis bootstrap (`make bootstrap`) — the Genesis Moderator's identity.
# Supplied at run time (network.md §2); a fork sets its own.
GENESIS_HANDLE=genesis
GENESIS_DISPLAY_NAME=Genesis Moderator

# The operator's login for the genesis account (architecture.md "Genesis
# bootstrap"). Dev defaults; a real deployment MUST set its own before
# the first bootstrap run. The recovery code that restores the genesis
# actor in a client is printed once by that run.
GENESIS_EMAIL=genesis@cogra.local
GENESIS_PASSWORD=genesis-dev-password

# Logging: trace | debug | info | warn | error
RUST_LOG=debug
