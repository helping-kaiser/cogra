# The ranker pod (deployment.md "Topology"; ranker-core §4): its own
# container on the internal network, never inside the API process. The API
# relays feedRanking to it (RANKER_URL); it reads the slice back through
# the proxy's in-cluster listener (API_URL in ranker.env). The image is
# crates/ranker-server/Containerfile, retagged :deployed like the others.
[Unit]
Description=CoGra ranker
OnFailure=cogra-alert@%n.service
Wants=cogra-api.service
After=cogra-api.service

[Container]
ContainerName=cogra-ranker
Image=localhost/cogra-ranker:deployed
Pull=never
EnvironmentFile=/etc/cogra/ranker.env
Network=cogra-internal.network
# The image carries no probe of its own; the host's copy of the API image's
# http-health is mounted in (deploy/health/http-health.sh).
Volume=/usr/local/lib/cogra/http-health:/usr/local/bin/http-health:ro
HealthCmd=/usr/local/bin/http-health 8090 /health
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
# The binary drains on SIGTERM within 7 of the 10 stop-timeout seconds
# (crates/ranker-server/src/shutdown.rs); before its handlers exist PID 1
# would ignore the signal, and catatonit forwards it to a process that
# takes the default action.
RunInit=true
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=1024
PodmanArgs=--memory=2g --stop-timeout=10

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
