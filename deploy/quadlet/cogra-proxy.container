# The reverse proxy (deployment.md "Routing"): the sole ingress, so the
# API's RightmostXForwardedFor reading of the client address is sound.
# The only published ports on the host: 80 (ACME and the redirect) and 443
# over TCP and UDP (HTTP/3).
[Unit]
Description=CoGra proxy
OnFailure=cogra-alert@%n.service
Wants=cogra-web.service cogra-api.service
After=cogra-web.service cogra-api.service cogra-media.service

[Container]
ContainerName=cogra-proxy
Image=docker.io/library/caddy:2.11.7-alpine
Pull=never
EnvironmentFile=/etc/cogra/buckets.env
EnvironmentFile=/etc/cogra/proxy.env
Volume=/etc/cogra/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/etc/cogra/well-known:/srv/well-known:ro
Volume=cogra-caddy-data.volume:/data
Volume=cogra-caddy-config.volume:/config
Network=cogra-edge.network
Network=cogra-internal.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CAP_NET_BIND_SERVICE
PidsLimit=1024
PodmanArgs=--memory=512m --stop-timeout=10

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
