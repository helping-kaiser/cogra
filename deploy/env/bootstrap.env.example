# /etc/cogra/bootstrap.env — the one-time genesis bootstrap
# (deploy/scripts/bootstrap.sh; architecture.md "Genesis bootstrap").
# Root-owned, mode 0600. GENESIS_PASSWORD is the secret
# `cogra-genesis-password`, never this file.

GENESIS_HANDLE=genesis
GENESIS_DISPLAY_NAME=Genesis Moderator
# A real mailbox on the instance's domain: password resets must reach it.
GENESIS_EMAIL=operator@example.org
