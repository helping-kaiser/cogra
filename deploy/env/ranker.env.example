# /etc/cogra/ranker.env — cogra-ranker (deployment.md "Configuration";
# ranker-core §4.4). Root-owned, mode 0600. No secrets: the pod holds none.

# Where the pod reads the slice: the proxy's in-cluster listener, which
# sets the X-Forwarded-For the API requires (deploy/proxy/Caddyfile).
API_URL=http://cogra-proxy:8081/graphql
RANKER_BIND=0.0.0.0:8090
RUST_LOG=info
