# /etc/cogra/proxy.env — cogra-proxy (deployment.md "Routing").
# Root-owned, mode 0600. No secrets: the ACME account lives in Caddy's data
# volume.

# The one web origin (D-2): web, /graphql and /media. A public name with
# A/AAAA records on this host, so Caddy obtains its certificate itself.
COGRA_DOMAIN=example.org
# The ACME account's contact: expiry and revocation notices.
ACME_EMAIL=ops@example.org
