# /etc/cogra/web.env — cogra-web (deployment.md "Configuration").
# Root-owned, mode 0600. No secrets.

# Where server-side renders send GraphQL: the proxy's in-cluster listener,
# which sets the X-Forwarded-For the API requires (deploy/proxy/Caddyfile,
# the :8081 block). Never the API directly.
GRAPHQL_URL=http://cogra-proxy:8081/graphql

NEXT_TELEMETRY_DISABLED=1
