# /etc/cogra/alert.env — the on-box alerts (deploy/scripts/alert.sh,
# disk-watch.sh, log-alert.sh; deployment.md "Monitoring").
# Root-owned, mode 0600.

# The ntfy topic URL alerts are posted to. The topic name is the only
# access control ntfy.sh has: a long random one, kept like a secret.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic

# Alert when the data filesystem has less than this share free, in
# percent: the house's 15% line.
DISK_MIN_FREE_PERCENT=15
# Alert when the live media store's volume grows past this many bytes
# (media is the growth term). 500 GiB.
MEDIA_ALERT_BYTES=536870912000
