# /etc/cogra/postgres.env — cogra-postgres (deployment.md "Configuration").
# Root-owned, mode 0600. No secrets here: POSTGRES_PASSWORD is the podman
# secret `cogra-postgres-password`.

# The role and database the image creates on first start. api.env's
# DATABASE_URL names the same two.
POSTGRES_USER=cogra
POSTGRES_DB=cogra
