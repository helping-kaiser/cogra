# /etc/cogra/backup.env — the backup pair and the restore drill
# (deploy/scripts/backup.sh, restore.sh; deployment.md "Backups").
# Root-owned, mode 0600. It names secret FILES, never secret values.

# The off-box restic repository (D-5): a different provider, or at least a
# different data centre. Any restic backend; sftp shown.
RESTIC_REPOSITORY=sftp:backup@backup.example.net:/cogra
# The repository password. Without it every backup is unreadable: a copy
# lives in the operator's password manager, never only here.
RESTIC_PASSWORD_FILE=/etc/cogra/secrets/restic-password
# Backend credentials, where the backend reads them from the environment
# (an S3 backend's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), go in this
# root-only file, which the scripts source. sftp uses root's ssh key.
#BACKUP_CREDENTIALS_FILE=/etc/cogra/secrets/backup-credentials.env

# Where the dump and the media mirror are staged before restic reads them.
# On the data filesystem; the media mirror is incremental, so it stays.
BACKUP_STAGING=/var/lib/cogra/backup

# Retention (D-6): seven dailies and four weeklies, about thirty days. It
# bounds how long an erasure takes to leave every backup.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
