# /etc/cogra/buckets.env — the bucket names, said once and read by every
# unit that names a bucket: the API, both provisioning one-shots, the proxy
# (its /media route) and the backup (deployment.md "Media stores").
# Root-owned, mode 0600. The values are the development defaults; nothing
# requires changing them.

# The live bucket every MediaAttachment.url points into; anonymous reads.
MEDIA_BUCKET=cogra-media
# Where an applicant's media waits for the landing; on the live store, no
# anonymous policy.
MEDIA_CARRIED_BUCKET=cogra-media-carried
# Where a deleted asset's bytes go; on the held store, no anonymous policy.
MEDIA_HELD_BUCKET=cogra-media-held
