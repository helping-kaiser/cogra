# /etc/cogra/api.env — cogra-api (deployment.md "Configuration").
# Root-owned, mode 0600. Every variable the API reads is listed in
# development.md "Environment Variables"; this file sets the ones that
# differ from their defaults in production. NO SECRETS: the Postgres
# password, both stores' API keys, the session-signing seed and the SMTP
# URL arrive as podman secrets (deploy/quadlet/cogra-api.container).
#
# Replace example.org with the instance's domain (D-2).

# Postgres over the internal network. No password in the URL: PGPASSWORD
# is the secret `cogra-postgres-password`. User and database match
# postgres.env.
DATABASE_URL=postgres://cogra@cogra-postgres:5432/cogra

# The live store over the internal network; the keys are the secrets
# `cogra-media-api-key` / `cogra-media-api-secret`.
MEDIA_S3_ENDPOINT=http://cogra-media:9000
MEDIA_REGION=us-east-1
# The held store, its own service; its keys are the secrets
# `cogra-held-api-key` / `cogra-held-api-secret`.
MEDIA_HELD_S3_ENDPOINT=http://cogra-media-held:9000

# The public origin every MediaAttachment.url is minted against: the
# proxy's GET-only /media route on the one web origin.
MEDIA_BASE_URL=https://example.org/media

# The origin every emailed link rides on (auth.md "Link URLs"). Its
# default is the local dev server, so it is never left unset here.
WEB_ORIGIN=https://example.org

# Outbound mail (development.md, MAILER). SMTP_URL is the secret
# `cogra-smtp-url`; MAIL_FROM is an address on the instance's domain.
# Podman reads env files literally: no quotes around the value.
MAILER=smtp
MAIL_FROM=CoGra <no-reply@example.org>
# The bound on one delivery; the default until the first production send
# is measured.
#SMTP_TIMEOUT_SECS=30

# The proxy is the sole ingress (deploy/proxy/Caddyfile), so the client is
# the rightmost X-Forwarded-For hop (auth.md "Rate limiting").
CLIENT_IP_SOURCE=RightmostXForwardedFor

# The stand-in's epoch clock. Production runs on the stand-in, and unset
# an epoch closes only at 10,000 acts: a friends cohort's writes would
# never land. Three seconds is the cadence the pending states were
# hand-tested against.
L1_EPOCH_CLOSE_INTERVAL_SECS=3

# The ranker pod, over the internal network.
RANKER_URL=http://cogra-ranker:8090/graphql

# The live HIBP range API (fail-open); the host's egress stays open for it.
BREACH_CHECK=hibp

# info, not debug: request detail stays out of the journal.
RUST_LOG=info
# Plain log lines, no ANSI colour codes: the journal stores them as text,
# and log-alert.sh matches the level in it.
NO_COLOR=1

# Deliberately absent: DEV_MAILER_LOG (no token log file on a production
# disk), SESSION_SIGNING_SEED and SMTP_URL (secrets). ADMISSION_BURN_MICRO
# keeps its default unless D-8 decides otherwise.
