# /etc/cogra/media.env — both media stores, cogra-media and
# cogra-media-held (deployment.md "Media stores"). Root-owned, mode 0600.
# No secrets here: each store's root user and password are podman secrets.

# The web console is off: operators reach a store over ssh and
# `podman exec <store> mc …`, never a browser.
MINIO_BROWSER=off

# The store-side backstop for multipart uploads a crash orphans before
# their session row exists; matches the API's MEDIA_UPLOAD_SESSION_TTL_SECS
# (development.md "Environment Variables").
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=6h
