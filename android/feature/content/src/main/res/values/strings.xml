    <string name="content_refs_kind_tag">Tag</string>
    <!-- A citation at a person is a MENTION: the target's class is the
         whole distinction between quoting, embedding and mentioning. -->
    <string name="content_refs_kind_mention">Mention</string>
    <string name="content_refs_kind_post">Post</string>
    <string name="content_refs_kind_comment">Comment</string>
    <!-- A claim this instance cannot type is a reference and nothing
         more precise; it still counts, and still names its L1 id. -->
    <string name="content_refs_kind_reference">Reference</string>
    <!-- The row, spoken: the object's or face's reading is lossy, so the
         pair is spelled out beside it. A tag's word names a degree of
         aboutness and is true of the row; a stance anchor's names a
         feeling about a stance, which a citation is not — so the
         citation's reading is its two axes and nothing else. -->
    <string name="content_refs_row_tag">#%1$s, %2$s, relevance %3$s, confidence %4$s</string>
    <string name="content_refs_row_reference">%1$s, %2$s, relevance %3$s, support %4$s</string>

