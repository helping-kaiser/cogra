    <string name="stance_target">Stance</string>
    <string name="stance_target_action">Tap for a light yes, or press and hold to pick exactly</string>
    <!-- A target that already carries a standing says so first. -->
    <string name="stance_target_with_standing">%1$s: %2$s. %3$s</string>
    <!-- WHAT IT STANCES TOWARD, FIRST (`TagPage`, the topic round). A
         page may carry more than one stance control — the topic's row
         and every card's — and the accessible name is the only thing
         that says which is which. Only surfaces that do not already
         name their target from context pass one. -->
    <string name="stance_target_labelled">%1$s. %2$s</string>
    <!-- The transient confirmation a signed stance leaves (design.md §8.3).
         "Still settling" is the honest part: the standing it names is the
         pending-inclusive fold, counting a record not yet on L1 (§9). -->
    <string name="stance_signed">Signed, still settling. %1$s: %2$s</string>
    <string name="stance_pick_exactly">Pick exactly</string>

    <!-- The two things a reader is told apart: what this pick says, and
         where it leaves them (design.md §8.2). -->
    <string name="stance_axis_directed">How you stand</string>
    <string name="stance_axis_interest">In your world</string>
    <!-- THE AFFINITY FAMILY'S OWN TWO (ruled 2026-09-15, drawn on
         `TagPageHeldPad`). Following a topic IS the stance gesture, but
         the two slots it fills are association and attraction, and
         neither is asked by the opinion's question: "how you stand"
         names a verdict an Affinity does not carry, and "in your world"
         names reach rather than closeness. Carried through
         `StanceAxes`, never swapped in by a surface. -->
    <string name="stance_axis_affinity_directed">How much you like it</string>
    <string name="stance_axis_affinity_interest">How close you want to be</string>
    <string name="stance_standing">Where you stand now</string>
    <string name="stance_standing_none">You haven\'t said anything about this yet</string>
    <!-- The zero bundle's own wording (design.md §8.4). A standing at
         exactly (0, 0) is the absence of a feeling, so it is named
         rather than read through the anchor table as its nearest
         neighbour — which would call it "Nice". -->
    <string name="stance_standing_zero">Nothing you\'ve said here carries</string>
    <!-- The raw sums, on the surfaces that explain cost (design.md §8.3).
         A bundle clipped at +1.00 whose raw sum is +6.00 costs a batch
         sized by the six, so the six is what gets stated. -->
    <string name="stance_standing_raw">Everything you\'ve said here adds up to</string>
    <string name="stance_landing">This leaves you at</string>
    <string name="stance_landing_working">Working out where this leaves you…</string>
    <string name="stance_reading">%1$s %2$s, %3$s %4$s</string>
    <!-- The exact pair, part of the default reading (design.md §8.3). -->
    <string name="stance_pair">%1$s / %2$s</string>

    <!-- THE ONE AXIS, for the surfaces where a pick names a valence and
         nothing else (design/readme.md §11 renamed it: `How you stand`
         → `For or against`, with its ends drawn on the field).

         Deliberately its own string rather than `stance_axis_directed`:
         that one still carries the pre-rename wording and feeds every
         two-axis surface, so renaming it from here would rewrite the
         bloomed control's readouts. The two-axis surfaces are reported
         rather than renamed in passing. -->
    <string name="valence_axis">For or against</string>
    <string name="valence_pole_against">Against</string>
    <string name="valence_pole_for">For</string>
    <!-- The one-axis reading: the anchor's word, then the axis and the
         one number — `Nice, For or against +0.10`. -->
    <string name="valence_reading">%1$s, %2$s %3$s</string>
    <string name="stance_carries_nothing">This would carry nothing.</string>
    <string name="stance_carries_nothing_directed">Where you stand would carry nothing.</string>
    <string name="stance_carries_nothing_interest">What reaches you would carry nothing.</string>

    <string name="stance_exact_values_show">Set exact values</string>
    <string name="stance_exact_values_hide">Hide exact values</string>
    <string name="stance_set">Set this stance</string>
    <string name="stance_cancel">Cancel</string>
    <string name="stance_failed">That didn\'t go through. Try again.</string>
    <string name="stance_failed_no_key">This device can\'t sign yet. Restore your key first.</string>

    <!-- Severance: the one gesture that nets a bundle back to nothing
         (design.md §8.5). The route is findable from the open pad. -->
    <!-- The route's own wording, and deliberately not the ceremony's
         (`TagPageHeldPad`, drawn 2026-09-15; web's #760): the button is
         what a reader looking for the way out reads, and "Walk it back"
         is what the gesture does. The confirmation that follows keeps
         the word for the act itself. -->
    <string name="stance_severance_open">Walk it back</string>
    <string name="stance_severance_title">Sever this?</string>
    <string name="stance_severance_reached">This pick nets everything you\'ve said about it back to nothing.</string>
    <string name="stance_severance_body">Nothing you\'ve said about it carries any more: it stops reaching you, it earns you nothing, and nothing you vouch for travels through it.</string>
    <plurals name="stance_severance_cost">
        <item quantity="one">It takes %d signed action, each paid for separately.</item>
        <item quantity="other">It takes %d signed actions, each paid for separately.</item>
    </plurals>
    <string name="stance_severance_already">You are already at nothing here.</string>
    <string name="stance_severance_confirm">Sever</string>
    <string name="stance_severance_keep">Keep it</string>
    <string name="stance_severance_failed">Severing didn\'t go through. Try again.</string>

    <!-- A topic's own way out: DISCONNECTED, never severed (jakob's I2
         ruling, copy-voice.md "Awaiting blessing — the topic disconnects",
         2026-09-15: "we want human wording not this nerdy stuff!" —
         rejecting "walked back", "let go" and "dropped" for a topic in
         one breath). The split is by record family, not by surface:
         persons, posts and comments keep every string above verbatim; a
         topic's pad and its confirmation swap these in instead. -->
    <string name="stance_disconnect_open">Disconnect</string>
    <string name="stance_disconnect_title">Disconnect from %1$s?</string>
    <string name="stance_disconnect_reached">This leaves you with no opinion towards it.</string>
    <string name="stance_disconnect_body">You end up with no opinion towards %1$s. It stops reaching your feed, you stop earning from it, and nothing passes on through you.</string>
    <string name="stance_disconnect_standing_zero">No opinion towards %1$s.</string>
    <string name="stance_disconnect_confirm">Disconnect</string>
    <!-- The confirmation's raw-sums total (copy-voice.md "the topic
         disconnects": "Everything you've said about #saltmaps adds up
         to +1.40 / +0.95, and disconnecting clears all of it."). One
         self-contained sentence, unlike `stance_standing_raw`'s label
         the caller appends a reading to. -->
    <string name="stance_disconnect_standing_raw">Everything you\'ve said about %1$s adds up to %2$s, and disconnecting clears all of it.</string>

    <string name="stance_coach">Press and hold to pick exactly where you stand.</string>
    <string name="stance_coach_dismiss">Got it</string>

    <!-- The `?` on the pad (design.md §8.3): the explanation on demand,
         for anyone who met the control after the one-time coach mark was
         spent. It says what the two axes are and what actually signs,
         because nothing here should be learned by accident. -->
    <string name="stance_explain">How stances work</string>
    <!--
      The master's four lines, in the order a reader needs them: what the
      field means, what commits, why the three readouts differ, and what
      the way out costs (design/components/stance/StanceCoachMark.jsx).
      The third is the one nobody can guess.
    -->
    <string name="stance_explain_field">Drag the knob to where you stand. Left to right is against to for; bottom to top is how much more of it you want reaching you.</string>
    <string name="stance_explain_commit">Letting go changes nothing. Set signs it, Cancel leaves without signing.</string>
    <string name="stance_explain_adds">Your pick is one new thing you\'re saying. It adds to what you\'ve said before, which is why the resulting stance is a different number.</string>
    <string name="stance_explain_sever">Sever walks everything you\'ve said back to nothing. It has its own confirmation, and it costs one signed action per record.</string>
    <string name="stance_explain_back">Back to the pad</string>

    <!-- Screen-reader labels for the cover row. `contentDescription` is
         what TalkBack announces, so an unlocalized literal here has no
         visual text to fall back on. -->
    <string name="designsystem_cover_frame">Frame %1$d</string>
    <string name="designsystem_cover_own">Your own cover picture</string>
    <string name="designsystem_cover_own_action">A cover picture of your own</string>

    <!-- The video surface's two controls. Both are labelled by what the
         press does, not by what the clip is doing, which is what a
         screen reader announces on a button. -->
    <string name="designsystem_video_play">Play</string>
    <string name="designsystem_video_pause">Pause</string>
    <!-- A clip under the full transport stops at its end, so the press
         there starts it again rather than resuming it. -->
    <string name="designsystem_video_replay">Replay</string>
    <string name="designsystem_video_mute">Mute</string>
    <string name="designsystem_video_unmute">Unmute</string>

    <!-- The transport's rest, on the surfaces where the clip is the thing
         the reader came for. The skips say their size, because "ten
         seconds back" is the whole of what the glyph means. -->
    <string name="designsystem_video_rewind">Back ten seconds</string>
    <string name="designsystem_video_forward">Forward ten seconds</string>
    <string name="designsystem_video_seek">Seek</string>
    <!-- The bar's last control: the way into the fullscreen viewer
         (design/components/media/VideoControls.jsx:231). -->
    <string name="designsystem_video_fullscreen">Full screen</string>

    <!-- The gallery's dot row, read as a position. Positional arguments
         because the order of the two numbers is a property of the
         language, not of the layout. -->
    <string name="designsystem_gallery_position">Picture %1$d of %2$d</string>

    <!-- The fullscreen viewer's one control. An X rather than a back arrow,
         "because the reader is dismissing a layer, not walking a step of a
         journey" (design/components/media/MediaViewer.jsx:26-27). -->
    <string name="designsystem_viewer_close">Close</string>

    <!-- The sensitive veil (design/components/honesty/SensitiveVeil.jsx).
         The veil names its source unconditionally: an author's own warning
         and the platform's verdict read back as the same veil, so an
         unnamed source would read as the other one. A reason, where the
         author gave one, follows on the same line. -->
    <string name="sensitive_veil_label">Sensitive — tap to view</string>
    <string name="sensitive_source_author">The author\'s warning</string>
    <string name="sensitive_source_platform">The platform\'s verdict</string>
    <string name="sensitive_source_with_reason">%1$s — %2$s</string>
    <!-- The veil is one target: the label and the source line are read as
         one thing, and the whole block is the reveal. -->
    <string name="sensitive_veil_description">%1$s. %2$s</string>

    <!-- A surface that has nothing to show yet
         (design/components/states/EmptyState.jsx). A line of text, never
         a spinner: motion clarifies where something came from and never
         performs. -->
    <string name="loading_state">Loading…</string>
