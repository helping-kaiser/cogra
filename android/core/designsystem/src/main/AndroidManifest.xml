<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AutoplaySuppression reads whether the active network is metered
         (ConnectivityManager.isActiveNetworkMetered), which the platform
         gates on this normal, install-time permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
