<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        `ComposePick` draws the reader's own newest pictures inside the
        app, which means reading MediaStore rather than handing the whole
        choice to the system picker.

        The declaration follows the current guidance at
        developer.android.com/training/data-storage/shared/media#request-permissions:
        READ_MEDIA_IMAGES from API 33, READ_MEDIA_VISUAL_USER_SELECTED
        from API 34 so a reader may grant a chosen subset instead of the
        whole library, and READ_EXTERNAL_STORAGE capped at API 32 for the
        versions that predate the split. Requesting the two READ_MEDIA
        permissions together is what Android documents for a partial-access
        aware app; asking for READ_MEDIA_IMAGES alone would show the
        all-or-nothing dialog on API 34+.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        android:minSdkVersion="34" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".CograApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="CoGra"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoGra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CoGra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The canonical invite URL (auth.md "Link URLs"). Verification
                 needs the real deployed origin serving assetlinks.json; in
                 dev, drive links via `adb shell am start`. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${cograWebHost}"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>
    </application>

</manifest>
