; RFC 8610 Appendix H, second example: the same "reputon" structure
; in the more compact form.
; Source: https://www.rfc-editor.org/rfc/rfc8610.txt, retrieved 2026-08-21.
;
                        reputation-object = {
                          application: text
                          reputons: [* reputon]
                        }

                        reputon = {
                          rater: text
                          assertion: text
                          rated: text
                          rating: float16
                          ? confidence: float16
                          ? normal-rating: float16
                          ? sample-size: uint
                          ? generated: uint
                          ? expires: uint
                          * text => any
                        }
