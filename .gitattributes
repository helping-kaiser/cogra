# The checkout is LF everywhere, on every platform. Without this the line
# endings of a commit depend on each developer's global git config, and a
# contributor with Windows defaults commits CRLF that nothing in CI objects
# to (INFRA-15). `text=auto` still lets git detect binary content itself.
* text=auto eol=lf

# The two exceptions, both generated by Gradle and both shipped with the
# endings their interpreter expects: the Windows batch launcher is CRLF,
# the POSIX launcher is LF.
*.bat text eol=crlf
/android/gradlew text eol=lf
