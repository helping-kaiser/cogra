        "selector": "JSXOpeningElement[name.name='License'] > JSXAttribute > JSXIdentifier[name!=/^(?:attribution|provenance|key|ref|className|style|children)$/]",
        "message": "<License> doesn't accept that prop. Declared props: attribution, provenance."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaAttachment'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|poster|alt|ratio|kind|label|radius|fit|maxHeight|key|ref|className|style|children)$/]",
