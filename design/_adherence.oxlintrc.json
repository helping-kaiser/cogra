        "selector": "JSXOpeningElement[name.name='JoinPrompt'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|onSignIn|inline|key|ref|className|style|children)$/]",
        "message": "<JoinPrompt> doesn't accept that prop. Declared props: open, onClose, onSignIn, inline."
      },
