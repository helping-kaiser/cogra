        "message": "<Icon> name must be one of 'dynamic_feed' | 'person' | 'person_outline' | 'add' | 'search' | 'wallet' | 'settings' | 'visibility' | 'visibility_off' | 'arrow_back' | 'more_vert' | 'chat_bubble' | 'volume_up' | 'volume_off' | 'graph' | 'mark'."
      },
