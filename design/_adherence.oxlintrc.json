{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/honesty/**",
              "components/navigation/**",
              "components/people/**",
              "components/proposed/**",
              "components/stance/**",
              "components/states/**",
              "designs/core-loop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree))/i]",
        "message": "Font not provided by the design system. Available: Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActorChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:handle|displayName|href|onClick|avatarSrc|key|ref|className|style|children)$/]",
        "message": "<ActorChip> doesn't accept that prop. Declared props: handle, displayName, href, onClick, avatarSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|slots|onSelect|inline|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, slots, onSelect, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:feed|search|profile|wallet)$/]",
        "message": "<BottomNav> active must be one of 'feed' | 'search' | 'profile' | 'wallet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|ariaLabel|children|inline|maxHeight|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, onClose, ariaLabel, children, inline, maxHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|selfStart|disabled|type|onClick|ariaLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, selfStart, disabled, type, onClick, ariaLabel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, as, ariaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:section|article|div|li)$/]",
        "message": "<Card> as must be one of 'section' | 'article' | 'div' | 'li'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|onToggle|ariaLabel|disabled|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, selected, onToggle, ariaLabel, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollapsingTop'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|scrollHost|key|ref|className|style|children)$/]",
        "message": "<CollapsingTop> doesn't accept that prop. Declared props: children, scrollHost."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|content|timestamp|license|pending|edited|bundle|depth|replies|signedIn|taught|onCommit|onReply|onEdit|own|targetLabel|actions|menuItems|children|key|ref|className|style|children)$/]",
        "message": "<CommentCard> doesn't accept that prop. Declared props: author, content, timestamp, license, pending, edited, bundle, depth, replies, signedIn, taught, onCommit, onReply, onEdit, own, targetLabel, actions, menuItems, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, action, actionLabel, onAction."
