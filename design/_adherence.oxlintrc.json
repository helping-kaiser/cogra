        "message": "<ExplainableNumber> doesn't accept that prop. Declared props: label, value, unit, glyph, onOpenDetail."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedFilterValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:kinds|forms|order|also|key|ref|className|style|children)$/]",
        "message": "<FeedFilterValue> doesn't accept that prop. Declared props: kinds, forms, order, also."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|pickColor|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, pickColor, style."
      },
      {
