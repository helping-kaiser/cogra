  "query": "SELECT a.id AS \"id!\", a.kind AS \"kind!\", a.handle AS \"handle!\",\n                  a.actor_pubkey, a.l0_address, a.created_at AS \"created_at!\"\n           FROM actors a\n           JOIN system_actor_keys k ON k.actor_id = a.id\n           WHERE a.kind = 'user'\n           ORDER BY a.created_at\n           LIMIT 1",
